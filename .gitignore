# 1) Chan tat ca
/*

# 2) Mo lai dung nhung thu can cho Vercel
!/.gitignore
!/index.html
!/package.json
!/Logo_NexusT.png
!/README.md

!/css/
!/js/
!/api/

# 3) Trong tung thu muc cung chi cho phep dung loai file
css/*
!css/*.css

js/*
!js/*.js
!js/*.jsx

api/*
!api/*.js
